; Accepted off-chain provenance refreeze (2026-08-14) — exact pins only.
; A later `npm install <pkg>` must not be able to reintroduce a caret range.
save-exact=true
; Fail closed on install-time code execution: an integrity digest proves the
; tarball is what the registry published, not that its lifecycle script is
; benign. The accepted surface needs no install script to build or run.
ignore-scripts=true
engine-strict=false
