# Local secrets and environment
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor noise
.vscode/
.idea/
*.swp

# Generated build / cache artifacts (both compilation units)
cache/
cache-v3core/
out/
out-v3core/
out-slither/
out-coverage/
lcov.info
# Anchored to the repository root on purpose. A bare `coverage/` is a
# match-anywhere pattern, and it silently swallowed `tools/coverage/` — the
# coverage GATE, which CI invokes by path and which therefore has to be tracked.
/coverage/

# Foundry broadcast artifacts — launch-secret posture (sdd.md:L270).
# Production broadcast files embed the launch EOA, its nonces, predicted
# addresses, and genesis calldata; none of that may reach the public repository
# or public CI logs before the launch block. Enforced by
# tools/provenance/verify-launch-hygiene.sh.
broadcast/
broadcast/**

# Off-chain roots (Sprint 6). Dependencies are reproduced from the COMMITTED
# lockfiles under the accepted provenance refreeze — never vendored into the
# repository. `indexer/package-lock.json` and `web/package-lock.json` are tracked
# on purpose: they carry the integrity digests the accepted census pins, and
# `tools/offchain/verify-accepted-pins.mjs` fails closed if either is missing.
node_modules/
web/.next/
web/test-results/
web/playwright-report/
indexer/.ponder/
indexer/generated/
indexer/ponder-env.d.ts

# Loa disabled skills (feature-gated)
.claude/.skills-disabled/

# Loa framework files are vendored locally, never tracked.
# Only project-owned customizations are versioned.
.claude/*
!.claude/overrides/
!.claude/settings.json
